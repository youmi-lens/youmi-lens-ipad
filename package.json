    "test:navigation": "node scripts/navigation-polish.test.mjs",
    "test:physical-ui": "node scripts/physical-device-ui-regressions.test.mjs",
    "test:perceived": "node scripts/perceived-loading.test.mjs",
    "test:deletion": "node scripts/deletion-tombstones.test.mjs",
    "test:deletion-sync": "node scripts/deletion-sync.test.mjs",
    "test:envguard": "node scripts/env-guard.test.mjs",
    "verify:recording": "node scripts/verify-recording.mjs",
    "release:recording": "node scripts/verify-release.mjs",
    "release:recording:fast": "node scripts/verify-release.mjs --fast"
  },
