EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
EXPO_PUBLIC_API_BASE_URL=https://your_backend_base_url
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=904238201234-f9cjmceoaj9n2vum9bp037aosb2unuts.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=904238201234-71a99g4ike3r1vmt6fcd1ccnjb6tr49n.apps.googleusercontent.com

# Internal dogfooding only. Set to 1 in an internal build to route eligible
# testers to the durable native recorder. Absent/0 everywhere else, which is
# what keeps public builds on the legacy recorder. Never enable in a release build.
EXPO_PUBLIC_NATIVE_RECORDER_DOGFOOD=0

# Simulator-only R6 verification host. Must stay absent/0 in every tracked and
# release configuration. Only a local gitignored .env.local may set this to 1
# together with a DEBUG/__DEV__ build. Never enable for TestFlight or App Store.
# EXPO_PUBLIC_R6_SIMULATOR_VERIFY=0

# Remote rollout infrastructure gate. Must stay 0 until the rollout table is
# deployed and its RLS verified. With this off the app performs zero rollout
# requests. This is NOT per-user eligibility; see docs/verification/phase-4b-*.
EXPO_PUBLIC_RECORDING_ROLLOUT_REMOTE=0
